{
  "description": "Protección local contra operaciones Git de riesgo reconocibles.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) && python3 \"$root/.codex/hooks/protect_branches.py\"",
            "timeout": 5,
            "statusMessage": "Comprobando operación Git"
          }
        ]
      }
    ]
  }
}
